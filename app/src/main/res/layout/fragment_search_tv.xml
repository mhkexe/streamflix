<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/app_background_color"
	android:clipChildren="false"
	android:clipToPadding="false"
	android:paddingStart="48dp"
	android:paddingTop="40dp"
	android:paddingEnd="48dp"
	android:paddingBottom="32dp">

	<LinearLayout
		android:id="@+id/keyboard_panel"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:background="@drawable/bg_search_panel_tv"
		android:clipChildren="false"
		android:orientation="vertical"
		android:padding="16dp"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintEnd_toStartOf="@id/results_panel"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintWidth_percent="0.34">

		<LinearLayout
			android:id="@+id/btn_search_voice"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginEnd="4dp"
			android:focusable="true"
			android:focusableInTouchMode="true"
			android:gravity="center_vertical"
			android:orientation="horizontal">
			<ImageView
				android:id="@+id/iv_search_mic"
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:background="@drawable/bg_search_mic_tv"
				android:padding="10dp"
				android:src="@drawable/ic_mic"
				android:tint="@color/search_mic_icon_tint_tv" />
			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginStart="12dp"
				android:ellipsize="end"
				android:maxLines="1"
				android:text="Voice Search"
				android:textColor="#B3FFFFFF"
				android:textSize="14sp"
				android:textStyle="bold" />
		</LinearLayout>

		<EditText
			android:id="@+id/et_search_query"
			android:layout_width="1dp"
			android:layout_height="1dp"
			android:focusable="true"
			android:focusableInTouchMode="true"
			android:inputType="text"
			android:maxLines="1"
			android:alpha="0"
			android:visibility="visible" />

		<LinearLayout
			android:id="@+id/search_keyboard"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:orientation="vertical" />

	</LinearLayout>

	<LinearLayout
		android:id="@+id/results_panel"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:clipChildren="false"
		android:clipToPadding="false"
		android:orientation="vertical"
		android:paddingStart="32dp"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toEndOf="@id/keyboard_panel"
		app:layout_constraintTop_toTopOf="parent">
		<TextView
			android:id="@+id/tv_results_for"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="12dp"
			android:visibility="gone"
			android:textColor="#FFFFFF"
			android:textSize="24sp"
			android:textStyle="bold" />

		<FrameLayout
			android:id="@+id/search_content"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1"
			android:clipChildren="false"
			android:clipToPadding="false">
			<androidx.leanback.widget.VerticalGridView
				android:id="@+id/vgv_search_results"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:clipChildren="false"
				android:clipToPadding="false"
				android:paddingStart="12dp"
				android:paddingEnd="12dp"
				android:focusable="true"
				android:focusableInTouchMode="true"
				android:paddingBottom="24dp"
				android:visibility="gone"
				app:numberOfColumns="4" />

			<ProgressBar
				android:id="@+id/search_loading"
				android:layout_width="64dp"
				android:layout_height="64dp"
				android:layout_gravity="center"
				android:indeterminate="true"
				android:indeterminateTint="@color/search_loading_red"
				android:visibility="gone" />

			<LinearLayout
			android:id="@+id/search_empty_state"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:gravity="center"
			android:orientation="vertical">
			<ImageView
				android:layout_width="64dp"
				android:layout_height="64dp"
				android:alpha="0.7"
				android:contentDescription="@null"
				android:src="@drawable/ic_search_white"
				android:tint="#FFFFFF" />
			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:text="Start typing to search"
				android:textColor="#FFFFFF"
				android:textSize="24sp"
				android:textStyle="bold" />
			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="6dp"
				android:text="Use the keyboard or type with your remote"
				android:textColor="#8D939D"
				android:textSize="14sp" />
			</LinearLayout>
		</FrameLayout>
	</LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
