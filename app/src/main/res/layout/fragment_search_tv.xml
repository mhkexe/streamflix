<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.search.SearchTvFragment">

    <LinearLayout
        android:id="@+id/search_rail"
        android:layout_width="300dp"
        android:layout_height="0dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/search_input_container"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:descendantFocusability="afterDescendants"
            android:focusable="false">
            <androidx.leanback.widget.SearchEditText
                android:id="@+id/et_search"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_search_input_tv"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="10dp"
                android:drawableTint="#FFFFFF"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:hint="@string/search_input_hint"
                android:inputType="none"
                android:imeOptions="flagNoExtractUi"
                android:maxLines="1"
                android:nextFocusRight="@id/btn_search_voice"
                android:nextFocusDown="@id/keyboard_space"
                android:paddingStart="14dp"
                android:paddingEnd="58dp"
                android:textSize="18sp" />
            <ImageView
                android:id="@+id/btn_search_voice"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_search_key_tv"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/et_search"
                android:nextFocusDown="@id/keyboard_space"
                android:padding="12dp"
                android:src="@drawable/ic_mic"
                android:tint="#FFFFFF"
                tools:ignore="ContentDescription,UseAppTint" />
        </FrameLayout>

        <LinearLayout
                android:id="@+id/keyboard_actions"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/keyboard_space"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_key_tv"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="SPACE"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/keyboard_delete"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_key_tv"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="DELETE"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

        <GridLayout
            android:id="@+id/keyboard_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:columnCount="6"
            android:rowCount="6"
            android:useDefaultMargins="false" />
    </LinearLayout>

    <androidx.leanback.widget.VerticalGridView
        android:id="@+id/vgv_search"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/search_rail"
        app:layout_constraintTop_toTopOf="parent"
        tools:listitem="@layout/item_movie_tv" />

    <include
        android:id="@+id/is_loading"
        layout="@layout/layout_is_loading_tv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/vgv_search"
        app:layout_constraintEnd_toEndOf="@id/vgv_search"
        app:layout_constraintStart_toStartOf="@id/vgv_search"
        app:layout_constraintTop_toTopOf="@id/vgv_search" />

</androidx.constraintlayout.widget.ConstraintLayout>