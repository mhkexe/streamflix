<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_exo_controller"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@id/exo_controls_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#98000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone" />

    <TextView
        android:id="@+id/tv_exo_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="16dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        app:layout_constraintEnd_toStartOf="@id/btn_exo_external_player"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Title" />

    <TextView
        android:id="@+id/tv_exo_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="16dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#B3FFFFFF"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@id/btn_exo_external_player"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_exo_title"
        tools:text="Description" />

    <ImageView
        android:id="@+id/btn_exo_external_player"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="7dp"
        android:background="@drawable/bg_btn_exoplayer_tv"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusLeft="@id/btn_exo_external_player"
        android:nextFocusRight="@id/btn_exo_external_player"
        android:padding="12dp"
        android:src="@drawable/exo_styled_controls_external_player"
        android:tint="#FFFFFF"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/tv_exo_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_exo_title"
        tools:ignore="ContentDescription,PrivateResource,UseAppTint" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btn_custom_prev"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_btn_exoplayer_tv"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusRight="@id/exo_replay"
            android:nextFocusUp="@id/tv_exo_subtitle"
            android:nextFocusDown="@id/exo_bottom_bar"
            android:padding="10dp"
            android:src="@drawable/ic_previous"
            android:visibility="gone"
            app:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/exo_replay"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_btn_exoplayer_tv"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/btn_custom_prev"
            android:nextFocusRight="@id/exo_play_pause"
            android:nextFocusUp="@id/tv_exo_subtitle"
            android:nextFocusDown="@id/exo_bottom_bar"
            android:padding="10dp"
            android:src="@drawable/ic_refresh"
            android:visibility="gone"
            app:tint="#FFFFFF" />

        <ImageView
            android:id="@id/exo_play_pause"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_btn_exoplayer_tv"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/exo_replay"
            android:nextFocusRight="@id/btn_custom_next"
            android:nextFocusDown="@id/exo_settings"
            android:padding="2dp"
            android:src="@drawable/exo_styled_controls_play"
            android:tint="#FFFFFF"
            tools:ignore="ContentDescription,PrivateResource,UseAppTint" />

        <ImageView
            android:id="@+id/btn_custom_next"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_btn_exoplayer_tv"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/exo_play_pause"
            android:nextFocusUp="@id/tv_exo_subtitle"
            android:nextFocusDown="@id/exo_bottom_bar"
            android:padding="10dp"
            android:src="@drawable/ic_next"
            android:visibility="gone"
            app:tint="#FFFFFF" />

    </LinearLayout>

    <androidx.media3.ui.DefaultTimeBar
        android:id="@id/exo_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="4dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusDown="@id/exo_settings"
        app:played_color="#FFFFFFFF"
        app:unplayed_color="#B3FFFFFF"
        app:scrubber_color="#FFE50914"
        app:layout_constraintBottom_toTopOf="@id/exo_bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/player_shortcuts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="30dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@id/exo_bottom_bar"
        app:layout_constraintTop_toTopOf="@id/exo_bottom_bar"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btn_player_restart"
            style="@style/PlayerTvShortcut"
            android:contentDescription="@string/player_restart"
            android:src="@drawable/ic_refresh" />

        <ImageView
            android:id="@+id/btn_player_server"
            style="@style/PlayerTvShortcut"
            android:contentDescription="@string/player_settings_servers_title"
            android:src="@drawable/ic_player_settings_servers" />

        <ImageView
            android:id="@+id/btn_player_quality"
            style="@style/PlayerTvShortcut"
            android:contentDescription="@string/player_settings_quality_title"
            android:src="@drawable/ic_player_settings_quality" />

        <ImageView
            android:id="@+id/btn_player_audio"
            style="@style/PlayerTvShortcut"
            android:contentDescription="@string/player_settings_audio_title"
            android:src="@drawable/ic_player_settings_audio" />

        <ImageView
            android:id="@+id/btn_player_subtitle"
            style="@style/PlayerTvShortcut"
            android:contentDescription="@string/player_settings_subtitles_title"
            android:src="@drawable/ic_player_settings_subtitle_on" />

        <ImageView
            android:id="@+id/btn_player_settings"
            style="@style/PlayerTvShortcut"
            android:contentDescription="@string/player_settings_title"
            android:src="@drawable/exo_styled_controls_settings" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/exo_bottom_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@id/exo_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="00:00:00" />

        <TextView
            android:id="@+id/tv_time_separator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="·"
            android:textColor="#B3ffffff"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/exo_position"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@id/exo_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B3ffffff"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_time_separator"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="00:00:00" />

        <ImageView
            android:id="@id/btn_exo_aspect_ratio"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="7dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="7dp"
            android:background="@drawable/bg_btn_exoplayer_tv"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/btn_exo_aspect_ratio"
            android:nextFocusRight="@id/exo_settings"
            android:padding="12dp"
            android:src="@drawable/exo_styled_controls_aspect_ratio"
            android:visibility="gone"
            android:tint="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/exo_settings"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription,PrivateResource,UseAppTint" />


        <ImageView
            android:id="@id/exo_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="7dp"
            android:background="@drawable/bg_btn_exoplayer_tv"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/btn_exo_aspect_ratio"
            android:nextFocusRight="@id/exo_settings"
            android:padding="12dp"
            android:src="@drawable/exo_styled_controls_settings"
            android:visibility="gone"
            android:tint="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription,PrivateResource,UseAppTint" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>