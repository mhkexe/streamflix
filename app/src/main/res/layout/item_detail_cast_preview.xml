<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="108dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/iv_cast_preview_image"
        android:layout_width="match_parent"
        android:layout_height="108dp"
        android:background="@drawable/bg_detail_cast_image"
        android:clipToOutline="true"
        android:contentDescription="Cast member"
        android:scaleType="centerCrop"
        tools:src="@drawable/detail_preview_cast" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_cast_preview_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Alex Morgan" />

        <TextView
            android:id="@+id/tv_cast_preview_role"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#AEB5C0"
            android:textSize="13sp"
            tools:text="The Prologue Keeper" />
    </LinearLayout>
</LinearLayout>
