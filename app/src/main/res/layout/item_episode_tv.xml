<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <ImageView
        android:id="@+id/iv_episode_poster"
        android:layout_width="360dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_item_episode_image_tv"
        android:duplicateParentState="true"
        android:foreground="@drawable/fg_item_episode_image_tv"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <ImageView
        android:id="@+id/iv_episode_watched_ribbon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_margin="12dp"
        android:elevation="2dp"
        android:src="@drawable/ic_watched"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/iv_episode_poster"
        app:layout_constraintTop_toTopOf="@id/iv_episode_poster"
        tools:ignore="ContentDescription"
        tools:visibility="visible" />

    <ImageButton
        android:id="@+id/iv_episode_play"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_episode_play_tv"
        android:padding="14dp"
        android:src="@drawable/exo_styled_controls_play"
        android:clickable="false"
        android:focusable="false"
        android:tint="#FFFFFF"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/iv_episode_poster"
        app:layout_constraintEnd_toEndOf="@id/iv_episode_poster"
        app:layout_constraintStart_toStartOf="@id/iv_episode_poster"
        app:layout_constraintTop_toTopOf="@id/iv_episode_poster"
        tools:ignore="ContentDescription,PrivateResource,UseAppTint"
        tools:visibility="visible" />

    <ProgressBar
        android:id="@+id/pb_episode_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="5dp"
        android:layout_marginBottom="0dp"
        android:backgroundTint="#99000000"
        android:progressTint="#FF0000"
        app:layout_constraintBottom_toBottomOf="@id/iv_episode_poster"
        app:layout_constraintEnd_toEndOf="@id/iv_episode_poster"
        app:layout_constraintStart_toStartOf="@id/iv_episode_poster"
        tools:progress="80" />

    <TextView
        android:id="@+id/tv_episode_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:gravity="start"
        android:maxLines="1"
        android:textColor="#D8FFFFFF"
        android:textSize="13sp"
        app:layout_constraintEnd_toStartOf="@id/tv_episode_runtime"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_episode_poster"
        tools:text="Episode #" />

    <TextView
        android:id="@+id/tv_episode_runtime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:gravity="end"
        android:textColor="#D8FFFFFF"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_episode_poster"
        tools:text="45 min" />

    <TextView
        android:id="@+id/tv_episode_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:gravity="start"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_episode_info"
        tools:text="Title" />

    <TextView
        android:id="@+id/tv_episode_overview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="10dp"
        android:textSize="12sp"
        android:ellipsize="end"
        android:scrollHorizontally="false"
        android:singleLine="false"
        android:maxLines="4"
        app:layout_constraintTop_toBottomOf="@id/tv_episode_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Overview" />

</androidx.constraintlayout.widget.ConstraintLayout>
