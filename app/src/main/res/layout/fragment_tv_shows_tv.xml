<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    tools:context=".fragments.tv_shows.TvShowsTvFragment">

    <androidx.leanback.widget.VerticalGridView
        android:id="@+id/vgv_tv_shows"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:paddingTop="228dp"
        android:paddingBottom="16dp"
        android:paddingStart="@dimen/tv_shows_spacing"
        android:paddingEnd="@dimen/tv_shows_spacing"
        app:focusOutEnd="true"
        app:focusOutFront="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:numberOfColumns="6"
        tools:listitem="@layout/item_tv_show_grid" />

    <LinearLayout
        android:id="@+id/filter_bar"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="24dp"
        android:clipChildren="false"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btn_genre_filter"
            style="@style/TmdbFilterButton"
            android:layout_width="140dp"
            android:layout_height="match_parent"
            android:text="@string/tmdb_filter_genre_any" />

        <TextView
            android:id="@+id/btn_year_filter"
            style="@style/TmdbFilterButton"
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:text="@string/tmdb_filter_any_year" />

        <TextView
            android:id="@+id/btn_sort_filter"
            style="@style/TmdbFilterButton"
            android:layout_width="180dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:text="@string/tmdb_filter_most_popular" />

        <TextView
            android:id="@+id/btn_clear_filter"
            style="@style/TmdbFilterButton"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:text="@string/tmdb_filter_clear" />
    </LinearLayout>

    <include
        android:id="@+id/is_loading"
        layout="@layout/layout_is_loading_tv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>