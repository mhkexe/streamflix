<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tv_movie_recommendations_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="70dp"
        android:layout_marginEnd="70dp"
        android:text="@string/movie_you_may_also_like"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/fl_movie_recommendations_carousel"
        android:layout_width="0dp"
        android:layout_height="260dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/tv_movie_recommendations_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        >

        <androidx.leanback.widget.HorizontalGridView
            android:id="@+id/hgv_movie_recommendations"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="70dp"
            android:paddingTop="22dp"
            android:paddingEnd="70dp"
            android:paddingBottom="8dp"
            app:focusOutEnd="true"
            app:focusOutFront="true"
            tools:listitem="@layout/item_movie_tv" />

        <View
            android:layout_width="146dp"
            android:layout_height="218dp"
            android:layout_gravity="center"
            android:clickable="false"
            android:focusable="false"
            android:background="@drawable/bg_recommendation_selection_tv" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_movie_recommendations_selected"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="70dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="70dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fl_movie_recommendations_carousel"
        tools:text="Movie title • 2026" />

</androidx.constraintlayout.widget.ConstraintLayout>