<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme.Widget.Tv.Button" parent="AppTheme.Tv">
        <item name="android:background">@drawable/bg_button_tv</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@drawable/color_button_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="AppTheme.Widget.Mobile.Button" parent="AppTheme.Mobile">
        <item name="android:background">@drawable/bg_button_mobile</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">#000000</item>
    </style>

    <style name="AppTheme.Widget.Mobile.Button.Secondary" parent="AppTheme.Widget.Mobile.Button">
        <item name="android:background">@drawable/bg_button_secondary_mobile</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="PlayerTvShortcut">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginStart">1dp</item>
        <item name="android:layout_marginEnd">1dp</item>
        <item name="android:background">@drawable/bg_btn_exoplayer_tv</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:padding">10dp</item>
        <item name="android:tint">#FFFFFFFF</item>
    </style>

    <style name="PremiumPoint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:drawableStart">@drawable/ic_player_setting_check</item>
        <item name="drawableTint">#FFE50914</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:textColor">#EEEEEE</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TmdbFilterButton">
        <item name="android:background">@drawable/bg_filter_button</item>
        <item name="android:ellipsize">end</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textColor">@color/option_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Stile per forzare il fondo nero nelle schermate di impostazione (Leanback) -->
    <!-- Usiamo direttamente android:background nella preferenceTheme per non romper il build -->
    <style name="PreferenceThemeOverlay.Leanback.Amoled" parent="PreferenceThemeOverlayLeanback">
        <item name="android:windowBackground">?attr/app_background_color</item>
        <item name="android:colorBackground">?attr/app_background_color</item>
    </style>

</resources>
