<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_main_graph_mobile"
    app:startDestination="@id/providers">

    <fragment
        android:id="@+id/providers"
        android:name="com.nextservices.nextvision.fragments.providers.ProvidersMobileFragment"
        android:label="fragment_providers_mobile"
        tools:layout="@layout/fragment_providers_mobile">
        <action
            android:id="@+id/action_providers_to_home"
            app:destination="@id/home"
            app:enterAnim="@anim/detail_enter"
            app:exitAnim="@anim/detail_exit"
            app:popEnterAnim="@anim/detail_pop_enter"
            app:popExitAnim="@anim/detail_pop_exit" />
    </fragment>

    <!-- Global Actions -->
    <action
        android:id="@+id/action_global_providers"
        app:destination="@id/providers"
        app:enterAnim="@anim/detail_enter"
        app:exitAnim="@anim/detail_exit"
        app:popEnterAnim="@anim/detail_pop_enter"
        app:popExitAnim="@anim/detail_pop_exit" />
    <action
        android:id="@+id/action_global_player"
        app:destination="@id/player"
        app:enterAnim="@anim/detail_enter"
        app:exitAnim="@anim/detail_exit"
        app:popEnterAnim="@anim/detail_pop_enter"
        app:popExitAnim="@anim/detail_pop_exit" />
    <action
        android:id="@+id/action_global_tv_show"
        app:destination="@id/tv_show"
        app:enterAnim="@anim/detail_enter"
        app:exitAnim="@anim/detail_exit"
        app:popEnterAnim="@anim/detail_pop_enter"
        app:popExitAnim="@anim/detail_pop_exit" />
    <action
        android:id="@+id/action_global_movie"
        app:destination="@id/movie"
        app:enterAnim="@anim/detail_enter"
        app:exitAnim="@anim/detail_exit"
        app:popEnterAnim="@anim/detail_pop_enter"
        app:popExitAnim="@anim/detail_pop_exit" />
    <action
        android:id="@+id/action_global_search_mobile"
        app:destination="@id/search_mobile"
        app:enterAnim="@anim/detail_enter"
        app:exitAnim="@anim/detail_exit"
        app:popEnterAnim="@anim/detail_pop_enter"
        app:popExitAnim="@anim/detail_pop_exit" />
    <action
        android:id="@+id/action_global_guest_user"
        app:destination="@id/guest_user"
        app:enterAnim="@anim/detail_enter"
        app:exitAnim="@anim/detail_exit"
        app:popEnterAnim="@anim/detail_pop_enter"
        app:popExitAnim="@anim/detail_pop_exit" />

    <fragment
        android:id="@+id/home"
        android:name="com.nextservices.nextvision.fragments.home.HomeMobileFragment"
        android:label="fragment_home_mobile"
        tools:layout="@layout/fragment_home_mobile">
        <action
            android:id="@+id/action_home_to_movie"
            app:destination="@id/movie"
            app:enterAnim="@anim/detail_enter"
            app:exitAnim="@anim/detail_exit"
            app:popEnterAnim="@anim/detail_pop_enter"
            app:popExitAnim="@anim/detail_pop_exit" />
        <action
            android:id="@+id/action_home_to_tv_show"
            app:destination="@id/tv_show"
            app:enterAnim="@anim/detail_enter"
            app:exitAnim="@anim/detail_exit"
            app:popEnterAnim="@anim/detail_pop_enter"
            app:popExitAnim="@anim/detail_pop_exit" />
        <action
            android:id="@+id/action_home_to_player"
            app:destination="@id/player"
            app:enterAnim="@anim/detail_enter"
            app:exitAnim="@anim/detail_exit"
            app:popEnterAnim="@anim/detail_pop_enter"
            app:popExitAnim="@anim/detail_pop_exit" />
    </fragment>
    <fragment
        android:id="@+id/favorites"
        android:name="com.nextservices.nextvision.fragments.favorites.FavoritesMobileFragment"
        android:label="fragment_favorites_mobile"
        tools:layout="@layout/fragment_favorites_mobile">
        <action
            android:id="@+id/action_favorites_to_movie"
            app:destination="@id/movie"
            app:enterAnim="@anim/detail_enter"
            app:exitAnim="@anim/detail_exit"
            app:popEnterAnim="@anim/detail_pop_enter"
            app:popExitAnim="@anim/detail_pop_exit" />
        <action
            android:id="@+id/action_favorites_to_tv_show"
            app:destination="@id/tv_show"
            app:enterAnim="@anim/detail_enter"
            app:exitAnim="@anim/detail_exit"
            app:popEnterAnim="@anim/detail_pop_enter"
            app:popExitAnim="@anim/detail_pop_exit" />
    </fragment>
    <fragment
        android:id="@+id/premium"
        android:name="com.nextservices.nextvision.fragments.premium.PremiumMobileFragment"
        android:label="fragment_premium_mobile"
        tools:layout="@layout/fragment_premium_mobile" />
    <fragment
        android:id="@+id/search_mobile"
        android:name="com.nextservices.nextvision.fragments.search.SearchMobileFragment"
        android:label="search_mobile"
        tools:layout="@layout/fragment_search_mobile" />
    <fragment
        android:id="@+id/guest_user"
        android:name="com.nextservices.nextvision.fragments.profile.GuestUserFragment"
        android:label="guest_user"
        tools:layout="@layout/fragment_guest_user" />
    <fragment
        android:id="@+id/collection"
        android:name="com.nextservices.nextvision.fragments.collection.CollectionMobileFragment"
        android:label="fragment_collection_mobile"
        tools:layout="@layout/fragment_collection_mobile">
        <argument
            android:name="id"
            app:argType="integer" />
    </fragment>
    <fragment
        android:id="@+id/movies"
        android:name="com.nextservices.nextvision.fragments.movies.MoviesMobileFragment"
        android:label="fragment_movies_mobile"
        tools:layout="@layout/fragment_movies_mobile">
        <action
            android:id="@+id/action_movies_to_movie"
            app:destination="@id/movie"
            app:enterAnim="@anim/detail_enter"
            app:exitAnim="@anim/detail_exit"
            app:popEnterAnim="@anim/detail_pop_enter"
            app:popExitAnim="@anim/detail_pop_exit" />
    </fragment>
    <fragment
        android:id="@+id/tv_shows"
        android:name="com.nextservices.nextvision.fragments.tv_shows.TvShowsMobileFragment"
        android:label="fragment_tv_shows_mobile"
        tools:layout="@layout/fragment_tv_shows_mobile">
        <action
            android:id="@+id/action_tv_shows_to_tv_show"
            app:destination="@id/tv_show"
            app:enterAnim="@anim/detail_enter"
            app:exitAnim="@anim/detail_exit"
            app:popEnterAnim="@anim/detail_pop_enter"
            app:popExitAnim="@anim/detail_pop_exit" />
    </fragment>
    <fragment
        android:id="@+id/movie"
        android:name="com.nextservices.nextvision.fragments.movie.MovieMobileFragment"
        android:label="fragment_movie_mobile"
        tools:layout="@layout/fragment_movie_mobile">
        <argument
            android:name="id"
            app:argType="string" />
        <action
            android:id="@+id/action_movie_to_player"
            app:destination="@id/player"
            app:enterAnim="@anim/detail_enter"
            app:exitAnim="@anim/detail_exit"
            app:popEnterAnim="@anim/detail_pop_enter"
            app:popExitAnim="@anim/detail_pop_exit" />
        <action
            android:id="@+id/action_movie_to_people"
            app:destination="@id/people"
            app:enterAnim="@anim/detail_enter"
            app:exitAnim="@anim/detail_exit"
            app:popEnterAnim="@anim/detail_pop_enter"
            app:popExitAnim="@anim/detail_pop_exit" />
        <action
            android:id="@+id/action_movie_to_movie"
            app:destination="@id/movie"
            app:enterAnim="@anim/detail_enter"
            app:exitAnim="@anim/detail_exit"
            app:popEnterAnim="@anim/detail_pop_enter"
            app:popExitAnim="@anim/detail_pop_exit" />
        <action
            android:id="@+id/action_movie_to_tv_show"
            app:destination="@id/tv_show"
            app:enterAnim="@anim/detail_enter"
            app:exitAnim="@anim/detail_exit"
            app:popEnterAnim="@anim/detail_pop_enter"
            app:popExitAnim="@anim/detail_pop_exit" />
    </fragment>
    <fragment
        android:id="@+id/tv_show"
        android:name="com.nextservices.nextvision.fragments.tv_show.TvShowMobileFragment"
        android:label="fragment_tv_show_mobile"
        tools:layout="@layout/fragment_tv_show_mobile">
        <argument
            android:name="id"
            app:argType="string" />
        <argument
            android:name="poster"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="banner"
            app:argType="string"
            app:nullable="true" />
        <action
            android:id="@+id/action_tv_show_to_season"
            app:destination="@id/season"
            app:enterAnim="@anim/detail_enter"
            app:exitAnim="@anim/detail_exit"
            app:popEnterAnim="@anim/detail_pop_enter"
            app:popExitAnim="@anim/detail_pop_exit" />
        <action
            android:id="@+id/action_tv_show_to_people"
            app:destination="@id/people"
            app:enterAnim="@anim/detail_enter"
            app:exitAnim="@anim/detail_exit"
            app:popEnterAnim="@anim/detail_pop_enter"
            app:popExitAnim="@anim/detail_pop_exit" />
        <action
            android:id="@+id/action_tv_show_to_movie"
            app:destination="@id/movie"
            app:enterAnim="@anim/detail_enter"
            app:exitAnim="@anim/detail_exit"
            app:popEnterAnim="@anim/detail_pop_enter"
            app:popExitAnim="@anim/detail_pop_exit" />
        <action
            android:id="@+id/action_tv_show_to_tv_show"
            app:destination="@id/tv_show"
            app:enterAnim="@anim/detail_enter"
            app:exitAnim="@anim/detail_exit"
            app:popEnterAnim="@anim/detail_pop_enter"
            app:popExitAnim="@anim/detail_pop_exit" />
        <action
            android:id="@+id/action_tv_show_to_player"
            app:destination="@id/player"
            app:enterAnim="@anim/detail_enter"
            app:exitAnim="@anim/detail_exit"
            app:popEnterAnim="@anim/detail_pop_enter"
            app:popExitAnim="@anim/detail_pop_exit" />
    </fragment>
    <fragment
        android:id="@+id/season"
        android:name="com.nextservices.nextvision.fragments.season.SeasonMobileFragment"
        android:label="fragment_season_mobile"
        tools:layout="@layout/fragment_season_mobile">
        <action
            android:id="@+id/action_season_to_player"
            app:destination="@id/player"
            app:enterAnim="@anim/detail_enter"
            app:exitAnim="@anim/detail_exit"
            app:popEnterAnim="@anim/detail_pop_enter"
            app:popExitAnim="@anim/detail_pop_exit" />
        <argument
            android:name="tvShowId"
            app:argType="string" />
        <argument
            android:name="tvShowTitle"
            app:argType="string" />
        <argument
            android:name="tvShowPoster"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="tvShowBanner"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="seasonId"
            app:argType="string" />
        <argument
            android:name="seasonNumber"
            app:argType="integer" />
        <argument
            android:name="seasonTitle"
            app:argType="string"
            app:nullable="true" />
    </fragment>
    <fragment
        android:id="@+id/genre"
        android:name="com.nextservices.nextvision.fragments.genre.GenreMobileFragment"
        android:label="fragment_genre_mobile"
        tools:layout="@layout/fragment_genre_mobile">
        <argument
            android:name="id"
            app:argType="string" />
        <argument
            android:name="name"
            app:argType="string" />
        <action
            android:id="@+id/action_genre_to_movie"
            app:destination="@id/movie"
            app:enterAnim="@anim/detail_enter"
            app:exitAnim="@anim/detail_exit"
            app:popEnterAnim="@anim/detail_pop_enter"
            app:popExitAnim="@anim/detail_pop_exit" />
        <action
            android:id="@+id/action_genre_to_tv_show"
            app:destination="@id/tv_show"
            app:enterAnim="@anim/detail_enter"
            app:exitAnim="@anim/detail_exit"
            app:popEnterAnim="@anim/detail_pop_enter"
            app:popExitAnim="@anim/detail_pop_exit" />
    </fragment>
    <fragment
        android:id="@+id/people"
        android:name="com.nextservices.nextvision.fragments.people.PeopleMobileFragment"
        android:label="fragment_people_mobile"
        tools:layout="@layout/fragment_people_mobile">
        <argument
            android:name="id"
            app:argType="string" />
        <action
            android:id="@+id/action_people_to_movie"
            app:destination="@id/movie"
            app:enterAnim="@anim/detail_enter"
            app:exitAnim="@anim/detail_exit"
            app:popEnterAnim="@anim/detail_pop_enter"
            app:popExitAnim="@anim/detail_pop_exit" />
        <action
            android:id="@+id/action_people_to_tv_show"
            app:destination="@id/tv_show"
            app:enterAnim="@anim/detail_enter"
            app:exitAnim="@anim/detail_exit"
            app:popEnterAnim="@anim/detail_pop_enter"
            app:popExitAnim="@anim/detail_pop_exit" />
        <argument
            android:name="name"
            app:argType="string" />
        <argument
            android:name="image"
            app:argType="string"
            app:nullable="true" />
    </fragment>
    <fragment
        android:id="@+id/player"
        android:name="com.nextservices.nextvision.fragments.player.PlayerMobileFragment"
        android:label="fragment_player_mobile"
        tools:layout="@layout/fragment_player_mobile">
        <argument
            android:name="id"
            app:argType="string" />
        <argument
            android:name="title"
            app:argType="string" />
        <argument
            android:name="subtitle"
            app:argType="string" />
        <argument
            android:name="videoType"
            app:argType="com.nextservices.nextvision.models.Video$Type" />
        <argument
            android:name="preferredServerName"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <action
            android:id="@+id/action_playerMobileFragment_self"
            app:destination="@id/player"
            app:popUpTo="@id/player"
            app:popUpToInclusive="true" />
    </fragment>
</navigation>
